<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AirPodsWinTray.UI.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:AirPodsWinTray.UI">
    <Border x:Name="Card" Background="Transparent" BorderThickness="1" Padding="16"
            BorderBrush="{ThemeResource CardStrokeBrush}"
            Loaded="Card_Loaded"
            PointerPressed="Card_PointerPressed"
            PointerMoved="Card_PointerMoved"
            PointerReleased="Card_PointerReleased"
            PointerCaptureLost="Card_PointerCaptureLost"
            PointerEntered="Card_PointerEntered"
            PointerExited="Card_PointerExited"
            RightTapped="Card_RightTapped">
        <Grid>
            <StackPanel x:Name="EmptyPanel" Spacing="16" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="尚未绑定 AirPods" FontSize="16" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}"/>
                <TextBlock Text="在系统蓝牙里配对后，这里会自动出现。" FontSize="12"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextSecondaryBrush}"/>
                <Button Content="去绑定" Click="OnBind" Style="{StaticResource PillButtonStyle}"/>
            </StackPanel>

            <Grid x:Name="LargeBody" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid x:Name="Header" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ModelName" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               Foreground="{ThemeResource TextPrimaryBrush}"/>
                    <ComboBox x:Name="DeviceCombo" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Visibility="Collapsed" DisplayMemberPath="ContainerName"
                              SelectionChanged="OnDeviceSelected"/>
                    <Border x:Name="LinkPill" Grid.Column="1" VerticalAlignment="Center"
                            Background="{ThemeResource StatusFillBrush}" CornerRadius="10" Padding="10,4">
                        <TextBlock x:Name="LinkText" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </Border>
                </Grid>
                <Canvas Grid.Row="1" Width="264" Height="136" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:BatteryColumn x:Name="LeftPod"/>
                    <ui:BatteryColumn x:Name="RightPod"/>
                    <ui:BatteryColumn x:Name="CasePod"/>
                </Canvas>
                <StackPanel Grid.Row="2" Spacing="12">
                    <TextBlock x:Name="BatteryNote" FontSize="12" HorizontalAlignment="Center" Visibility="Collapsed"
                               Foreground="{ThemeResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="HfpHint" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               Text="音乐场景建议在「设备和打印机」里关掉 Hands-Free Telephony，音质更好、连接更快。"/>
                    <Button x:Name="HfpDismiss" Content="知道了" Visibility="Collapsed" Click="OnDismissHfp"
                            Style="{StaticResource MenuButtonStyle}" HorizontalAlignment="Right"/>
                    <Button x:Name="ActionButton" Content="连接" Click="OnAction" Style="{StaticResource PillButtonStyle}"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="CompactBar" Visibility="Collapsed" ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CompactName" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextPrimaryBrush}"/>
                <TextBlock x:Name="CompactLevels" Grid.Column="1" FontSize="13" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           Foreground="{ThemeResource TextSecondaryBrush}"/>
                <Button x:Name="StatusDot" Grid.Column="2" Click="OnAction" Style="{StaticResource CompactActionStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="StatusMark" Width="8" Height="8" VerticalAlignment="Center" Fill="#8E8E93"/>
                        <TextBlock x:Name="CompactLink" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
