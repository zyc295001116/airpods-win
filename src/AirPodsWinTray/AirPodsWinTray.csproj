<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon />
    <StartupObject>AirPodsWinTray.Program</StartupObject>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>AirPodsWinTray</RootNamespace>
    <AssemblyName>AirPodsWinTray</AssemblyName>
    <Description>Lightweight AirPods companion for Windows 11</Description>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AirPodsWinTray.Core\AirPodsWinTray.Core.csproj" />
  </ItemGroup>

</Project>